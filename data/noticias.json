    "subtitulo": "<script src=\"script.js\"></script>   <script>     // Inicialización de íconos de Lucide     document.addEventListener('DOMContentLoaded', () => {       if (window.lucide) lucide.createIcons();       loadHomeDynamicSections();     });      function openUniversalModal(htmlContent) {       document.getElementById('universalModalContent').innerHTML = htmlContent;       document.getElementById('universalPreviewModal').classList.add('show');       if (window.lucide) lucide.createIcons();     }      function closeUniversalModal() {       document.getElementById('universalPreviewModal').classList.remove('show');     }      // Cerrar modal haciendo clic fuera de la caja     document.getElementById('universalPreviewModal').addEventListener('click', (e) => {       if (e.target.id === 'universalPreviewModal') closeUniversalModal();     });      // Cargar dinámicamente Noticias, Destacados, Fuentes (Repositorios) y Carrusel de Videos     async function loadHomeDynamicSections() {       try {         // 1. Cargar Noticias para la sección \"Últimas Noticias\" (Efecto 3D Transparente)         try {           const resNoticias = await fetch('/api/noticias');           if (resNoticias.ok) {             const noticias = await resNoticias.json();             const noticiasContainer = document.getElementById('homeNoticiasContainer');             const latestNoticias = Array.isArray(noticias) ? noticias.slice(0, 3) : [];              if (latestNoticias.length > 0) {               noticiasContainer.innerHTML = latestNoticias.map(item => {                 const title = item.titulo || item.title || 'Sin título';                 const subtitle = item.subtitulo || item.descripcion || item.summary || 'Sin descripción disponible...';                 const fullContent = item.content || item.contenido || subtitle;                 const cover = item.coverUrl || item.image || item.imagen || 'blogpre.jpg';                 const category = item.categoria || item.category || 'Noticia';                 const author = item.autor || item.author || 'El Tío Baza';                 const date = item.fecha || item.date || (item.createdAt ? new Date(item.createdAt).toLocaleDateString() : 'Reciente');                  return `                   <div class=\"news-3d-card\" onclick='showDetailedNewsModal(${JSON.stringify(title)}, ${JSON.stringify(fullContent)}, ${JSON.stringify(cover)}, ${JSON.stringify(author)}, ${JSON.stringify(date)}, ${JSON.stringify(category)})'>                     <div class=\"news-3d-media\">                       <img src=\"${cover}\" alt=\"${title}\">                       <div style=\"position: absolute; top: 10px; left: 10px;\">                         <span style=\"background: rgba(16,124,16,0.85); backdrop-filter: blur(4px); color: #fff; padding: 4px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: 700;\">${category}</span>                       </div>                     </div>                     <div class=\"news-3d-content\">                       <h3 style=\"margin: 0; font-size: 1.05rem; color: #fff; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;\">${title}</h3>                       <p style=\"margin: 0; font-size: 0.83rem; color: var(--text-secondary); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;\">${subtitle.replace(/<[^>]*>?/gm, '')}</p>                       <div class=\"news-3d-meta\">                         <span><i data-lucide=\"user\" style=\"width: 12px; height: 12px; vertical-align: middle;\"></i> ${author}</span>                         <span><i data-lucide=\"calendar\" style=\"width: 12px; height: 12px; vertical-align: middle;\"></i> ${date}</span>                       </div>                     </div>                   </div>                 `;               }).join('');               if (window.lucide) lucide.createIcons();             } else {               noticiasContainer.innerHTML = '<p style=\"color: var(--text-secondary);\">No hay noticias disponibles.</p>';             }           }         } catch (e) {           console.warn('Endpoint de noticias no disponible o vacío', e);           const noticiasContainer = document.getElementById('homeNoticiasContainer');           if (noticiasContainer) noticiasContainer.innerHTML = '<p style=\"color: var(--text-secondary);\">No se pudieron cargar las noticias.</p>';         }          // 2. Cargar Posts para la sección \"Destacado\"         const resPosts = await fetch('/api/posts');         if (resPosts.ok) {           const posts = await resPosts.json();           const destContainer = document.getElementById('homeDestacadoContainer');           const featured = posts.find(p => p.destacado) || posts[0];            if (featured && destContainer) {             const title = featured.titulo || featured.title || 'Sin título';             const subtitle = featured.subtitulo || featured.descripcion || 'Sin descripción disponible...';             const cover = featured.coverUrl || 'blogpre.jpg';             const fullContent = featured.content || subtitle;              destContainer.innerHTML = `               <div class=\"featured-diagonal-card\" onclick='showPostModal(${JSON.stringify(title)}, ${JSON.stringify(fullContent)}, ${JSON.stringify(cover)})'>                 <div class=\"diagonal-media-wrapper\">                   <img src=\"${cover}\" alt=\"${title}\">                 </div>                 <div class=\"diagonal-content\">                   <span class=\"tag\" style=\"background: rgba(16,124,16,0.2); color: var(--primary-green); padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;\">${featured.categoria || 'Destacado'}</span>                   <h3 style=\"margin: 10px 0 6px 0; font-size: 1.15rem; color: #fff;\">${title}</h3>                   <p style=\"margin: 0; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.4;\">${subtitle}</p>                 </div>               </div>             `;           } else if (destContainer) {             destContainer.innerHTML = '<p style=\"color: var(--text-secondary);\">No hay publicaciones destacadas.</p>';           }         }          // 3. Cargar Repositorios para \"Fuentes Recomendadas\"         const resRepos = await fetch('/api/repos');         if (resRepos.ok) {           const repos = await resRepos.json();           const reposContainer = document.getElementById('homeReposContainer');            if (repos && repos.length > 0 && reposContainer) {             reposContainer.innerHTML = repos.map(repo => {               const name = repo.titulo || repo.title || 'Herramienta';               const logo = repo.logoUrl || repo.coverUrl || 'blogpre.jpg';               const desc = repo.descripcion || 'Sin descripción.';               const extDesc = repo.extendedDesc || desc;               const download = repo.downloadUrl || '#';               const version = repo.version || 'v1.0';                return `                 <div class=\"source-app-card\" onclick='showRepoModal(${JSON.stringify(name)}, ${JSON.stringify(logo)}, ${JSON.stringify(desc)}, ${JSON.stringify(extDesc)}, ${JSON.stringify(download)}, ${JSON.stringify(version)})'>                   <img src=\"${logo}\" alt=\"${name}\" class=\"source-app-logo\">                   <span class=\"source-app-name\">${name}</span>                   <span style=\"font-size: 0.7rem; color: var(--text-secondary);\">${version}</span>                 </div>               `;             }).join('');           } else if (reposContainer) {             reposContainer.innerHTML = '<p style=\"color: var(--text-secondary);\">No hay fuentes registradas.</p>';           }         }          // 4. Cargar Videos para el Carrusel         const resVideos = await fetch('/api/videos');         if (resVideos.ok) {           const videos = await resVideos.json();           const videoContainer = document.getElementById('homeVideoCarousel');            if (videos && videos.length > 0 && videoContainer) {             videoContainer.innerHTML = videos.map((vid, idx) => {               const ytId = vid.youtubeId || vid.id || '';               const title = vid.titulo || vid.title || 'Video de YouTube';               const desc = vid.descripcion || vid.desc || 'Video exclusivo del canal.';               const thumbUrl = `https://img.youtube.com/vi/${ytId}/hqdefault.jpg`;               const ytLink = `https://www.youtube.com/watch?v=${ytId}`;                return `                 <div class=\"video-carousel-slide ${idx === 0 ? 'active' : ''}\" data-index=\"${idx}\">                   <img src=\"${thumbUrl}\" alt=\"${title}\" class=\"video-carousel-thumb\">                   <div style=\"flex: 1;\">                     <span style=\"font-size: 0.75rem; color: var(--primary-green); font-weight: 700;\"><i data-lucide=\"youtube\"></i> YouTube Video</span>                     <h3 style=\"margin: 6px 0; font-size: 1.1rem; color: #fff;\">${title}</h3>                     <p style=\"font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 12px; line-height: 1.4;\">${desc}</p>                     <a href=\"${ytLink}\" target=\"_blank\" style=\"display: inline-flex; align-items: center; gap: 6px; background: #ef4444; color: #fff; padding: 6px 14px; border-radius: 6px; text-decoration: none; font-size: 0.85rem; font-weight: bold;\">                       <i data-lucide=\"play\"></i> Ver en YouTube                     </a>                   </div>                 </div>               `;             }).join('');              initVideoCarousel();           } else if (videoContainer) {             videoContainer.innerHTML = '<p style=\"color: var(--text-secondary); padding: 20px; text-align: center;\">No hay videos disponibles.</p>';           }         }        } catch (err) {         console.error('Error cargando elementos dinámicos en el Index:', err);       }     }      // Funciones de previsualización para el Modal     function showDetailedNewsModal(title, content, cover, author, date, category) {       const html = `         <div style=\"display: flex; gap: 8px; align-items: center; margin-bottom: 12px;\">           <span style=\"background: rgba(16,124,16,0.2); color: var(--primary-green); padding: 3px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: bold;\">${category}</span>           <span style=\"font-size: 0.8rem; color: var(--text-secondary);\"><i data-lucide=\"calendar\" style=\"width: 12px; height: 12px; vertical-align: middle;\"></i> ${date}</span>         </div>         <h2 style=\"margin-top:0; color:#fff; font-size:1.35rem; line-height: 1.3;\">${title}</h2>         <div style=\"display: flex; align-items: center; gap: 8px; margin-bottom: 15px; font-size: 0.85rem; color: var(--text-secondary);\">           <span><i data-lucide=\"user\" style=\"width: 14px; height: 14px; vertical-align: middle;\"></i> Escrito por <strong>${author}</strong></span>         </div>         ${cover ? `<img src=\"${cover}\" style=\"width:100%; height:200px; object-fit:cover; border-radius:10px; margin-bottom:15px; border: 1px solid var(--border-color);\">` : ''}         <div style=\"color: var(--text-secondary); font-size:0.92rem; line-height:1.6; max-height: 350px; overflow-y: auto; padding-right: 4px;\">           ${content}         </div>       `;       openUniversalModal(html);     }      function showPostModal(title, content, cover) {       const html = `         ${cover ? `<img src=\"${cover}\" style=\"width:100%; height:180px; object-fit:cover; border-radius:8px; margin-bottom:15px;\">` : ''}         <h2 style=\"margin-top:0; color:#fff; font-size:1.3rem;\">${title}</h2>         <div style=\"color: var(--text-secondary); font-size:0.95rem; line-height:1.6; max-height: 350px; overflow-y: auto;\">           ${content}         </div>       `;       openUniversalModal(html);     }      function showRepoModal(name, logo, desc, extDesc, downloadUrl, version) {       const html = `         <div style=\"display:flex; align-items:center; gap:15px; margin-bottom:15px;\">           <img src=\"${logo}\" style=\"width:64px; height:64px; border-radius:12px; object-fit:cover; border:1px solid var(--border-color);\">           <div>             <h2 style=\"margin:0 0 4px 0; color:#fff; font-size:1.2rem;\">${name}</h2>             <span style=\"font-size:0.8rem; background: rgba(16,124,16,0.2); color: var(--primary-green); padding:2px 8px; border-radius:4px; font-weight:bold;\">${version}</span>           </div>         </div>         <p style=\"color: var(--text-secondary); font-size:0.9rem; margin-bottom:15px;\">${desc}</p>         <div style=\"background: rgba(15,23,42,0.5); padding:12px; border-radius:8px; border:1px solid var(--border-color); margin-bottom:20px; font-size:0.88rem; line-height:1.5;\">           ${extDesc}         </div>         ${downloadUrl && downloadUrl !== '#' ? `           <a href=\"${downloadUrl}\" target=\"_blank\" style=\"display:block; text-align:center; background: var(--primary-green); color:#fff; padding:10px; border-radius:8px; text-decoration:none; font-weight:bold;\">             <i data-lucide=\"download\"></i> Descargar / Ver Enlace           </a>         ` : ''}       `;       openUniversalModal(html);     }      // Lógica del Carrusel de Videos automático con intervalos de segundos     function initVideoCarousel() {       const slides = document.querySelectorAll('.video-carousel-slide');       if (slides.length <= 1) return;        let currentIndex = 0;       setInterval(() => {         slides[currentIndex].classList.remove('active');         currentIndex = (currentIndex + 1) % slides.length;         slides[currentIndex].classList.add('active');         if (window.lucide) lucide.createIcons();       }, 5000);     }   </script>",
